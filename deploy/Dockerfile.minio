FROM golang:1.23.4-bookworm AS build

ARG MINIO_VERSION=RELEASE.2024-12-18T13-15-44Z
RUN git clone --depth 1 --branch "${MINIO_VERSION}" \
        https://github.com/minio/minio.git /source \
    && cd /source \
    && CGO_ENABLED=0 GOPROXY=https://goproxy.cn,direct GOSUMDB=off \
        go build -tags kqueue -trimpath \
        --ldflags "$(MINIO_RELEASE=RELEASE go run buildscripts/gen-ldflags.go)" \
        -o /out/minio

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/minio /usr/local/bin/minio

EXPOSE 9000 9001
VOLUME ["/minio_data"]
