COMPOSE_PROJECT_NAME=pdf-learning-infra

MYSQL_DATABASE=pdf_learning
MYSQL_USER=pdf_learning
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
MYSQL_HOST_PORT=3307

MILVUS_DATABASE=default
MILVUS_RAG_COLLECTION=rag_chunks_dev
MINIO_ROOT_USER=pdflearning
MINIO_ROOT_PASSWORD=replace-with-a-random-password
NEO4J_PASSWORD=replace-with-a-random-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
EMBEDDING_VECTOR_DIMENSION=768

# 以下变量由宿主机上的 Java 和 Python 使用。
MYSQL_JDBC_URL='jdbc:mysql://127.0.0.1:3307/pdf_learning?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8'
MILVUS_URL=http://127.0.0.1:19530
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

JAVA_INTERNAL_TOKEN=replace-with-a-random-token
PYTHON_INTERNAL_TOKEN=replace-with-a-different-random-token
PYTHON_AGENT_BASE_URL=http://127.0.0.1:8800
MCP_INTERNAL_TOKEN=replace-with-a-third-random-token
JAVA_INTERFACE_HOST=127.0.0.1
JAVA_INTERFACE_PORT=8080
JAVA_STORAGE_BASE_URL=http://127.0.0.1:8080
USER_SERVICE_HOST=127.0.0.1
USER_SERVICE_PORT=8081
USER_ALLOWED_ORIGIN=http://localhost:5173
USER_TOKEN_TTL_HOURS=168
AGENT_GATEWAY_HOST=127.0.0.1
AGENT_GATEWAY_PORT=8082
AGENT_GATEWAY_ALLOWED_ORIGIN=http://localhost:5173
AGENT_MODEL_WINDOW=128000
AGENT_MAX_CONTEXT_TOKENS=100000
AGENT_OUTPUT_RESERVE=8000
AGENT_SAFETY_MARGIN=4000
AGENT_TOOL_RESULT_RESERVE=8000
AGENT_COMPACT_TRIGGER_RATIO=0.92
AGENT_SUMMARY_MAX_TOKENS=2000
AGENT_KEEP_RECENT_TURNS=5
RAG_MCP_HOST=127.0.0.1
RAG_MCP_PORT=8801
RAG_MCP_URL=http://127.0.0.1:8801/mcp
MEMORY_MCP_HOST=127.0.0.1
MEMORY_MCP_PORT=8802
MEMORY_MCP_URL=http://127.0.0.1:8802/mcp
RAG_ALLOWED_ROOT=/srv/pdf-learning/uploads
AGENT_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh

# Qdrant 继续使用 Cloud；填写 Cloud 控制台提供的地址与 API Key。
QDRANT_URL=https://replace-with-your-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace-with-qdrant-cloud-api-key
QDRANT_MEMORY_COLLECTION=agent_memory_dev
