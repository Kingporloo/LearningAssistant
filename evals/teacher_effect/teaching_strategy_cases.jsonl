{"schema_version":1,"case_id":"teaching.explanation.beginner_concept.001","category":"explanation","tags":["beginner","concept","example"],"conversation":[{"role":"user","content":"我是刚学 Python 的。请给我讲清楚列表和元组的区别，最好有一个具体例子。"}],"input_context":{"learner_level":"beginner","learner_preferences":[],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"explanation","must_do":["先直接解释列表与元组的核心区别","使用初学者能运行或读懂的具体例子","说明可变性带来的实际选择依据"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["直观区别","最小代码例子","何时选择哪一种"]},"forbidden_behavior":["只堆叠术语而不解释","在解释前先测试用户","声称元组在任何情况下都比列表快"],"reference_answer":{"facts":["列表通常可增删或修改元素","元组创建后不能通过常规元素赋值修改","两者都可保存有序元素，选择取决于数据是否应变化"]},"rubric":[{"dimension":"correctness_and_clarity","weight":0.45,"pass_condition":"准确说明核心区别，并把术语落到例子"},{"dimension":"learner_adaptation","weight":0.3,"pass_condition":"用初学者可理解的步幅和代码"},{"dimension":"question_strategy","weight":0.25,"pass_condition":"完成讲解且不附加无必要测验"}]}
{"schema_version":1,"case_id":"teaching.explanation.advanced_comparison.002","category":"explanation","tags":["advanced","comparison","concise"],"conversation":[{"role":"user","content":"我熟悉并发和异步 I/O。请直接比较 Python asyncio 的 TaskGroup 与 gather 的失败传播语义，不用解释协程基础。"}],"input_context":{"learner_level":"advanced","learner_preferences":["跳过基础概念"],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"explanation","must_do":["直接比较失败传播与兄弟任务取消行为","说明返回异常选项或异常组等关键条件","保持面向已有并发经验的技术密度"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["语义对照","失败时序例子","选择建议"]},"forbidden_behavior":["从什么是协程开始长篇讲解","虚构绝对等价的行为","用基础知识测验结束"] ,"reference_answer":{"facts":["TaskGroup 采用结构化并发并在成员任务出现非取消异常时取消其余任务","TaskGroup 退出时以 ExceptionGroup 等形式汇总适用异常","gather 的行为受 return_exceptions 参数影响，默认传播首个异常且不采用同样的 TaskGroup 取消语义"]},"rubric":[{"dimension":"correctness_and_clarity","weight":0.5,"pass_condition":"关键失败语义和条件准确"},{"dimension":"learner_adaptation","weight":0.35,"pass_condition":"跳过用户已掌握的基础"},{"dimension":"question_strategy","weight":0.15,"pass_condition":"直接完成比较，不加低价值问题"}]}
{"schema_version":1,"case_id":"teaching.explanation.complete_scope.003","category":"explanation","tags":["complete_answer","long_form","user_control"],"conversation":[{"role":"user","content":"请完整讲解梯度下降：直觉、公式、学习率影响和一个数值例子。请这次一次讲完，不要让我回复‘继续’。"}],"input_context":{"learner_level":"intermediate","learner_preferences":["一次覆盖请求范围"],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"explanation","must_do":["在一轮内覆盖用户列出的四项内容","解释公式符号和更新方向","给出至少一步可核对的数值更新"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["直觉","公式与符号","学习率过大过小的影响","数值计算"]},"forbidden_behavior":["人为截断并要求用户说继续","用提问代替请求的讲解","省略用户明确要求的部分"],"reference_answer":{"facts":["更新通常沿目标函数梯度的反方向进行","学习率决定单步更新尺度","学习率过大可能震荡或发散，过小通常收敛缓慢"]},"rubric":[{"dimension":"instruction_following","weight":0.3,"pass_condition":"一次完成明确范围"},{"dimension":"correctness_and_clarity","weight":0.5,"pass_condition":"概念、公式和例子相互对应"},{"dimension":"question_strategy","weight":0.2,"pass_condition":"不强制拆轮或留下测验"}]}
{"schema_version":1,"case_id":"teaching.explanation.direct_fact.004","category":"explanation","tags":["fact","direct_answer","restraint"],"conversation":[{"role":"user","content":"TCP 三次握手里，客户端第二次发送的报文是什么？一句话回答。"}],"input_context":{"learner_level":"unknown","learner_preferences":["简短回答"],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"direct_answer","must_do":["用一句话指出第二次报文由服务端发送且包含 SYN 和 ACK 标志"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["一句准确回答"]},"forbidden_behavior":["扩展成完整网络课程","先反问客户端第一次发了什么","错误地说第二次报文由客户端发送"],"reference_answer":{"facts":["三次握手的第二个报文由服务端发给客户端，通常置 SYN=1、ACK=1"]},"rubric":[{"dimension":"correctness_and_clarity","weight":0.6,"pass_condition":"方向和标志位准确"},{"dimension":"instruction_following","weight":0.25,"pass_condition":"遵守一句话要求"},{"dimension":"question_strategy","weight":0.15,"pass_condition":"不额外提问"}]}
{"schema_version":1,"case_id":"teaching.diagnostic.prerequisite_clarification.005","category":"diagnostic_question","tags":["clarification","ambiguous_goal","one_question"],"conversation":[{"role":"user","content":"教我怎么优化这个模型。"}],"input_context":{"learner_level":"unknown","learner_preferences":[],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"clarification","must_do":["指出当前缺少能决定方案的模型或目标信息","提出一个可合并收集模型类型、当前问题与指标的关键澄清问题"],"should_ask":true,"question_type":"clarifying","max_questions":1,"answer_policy":"conditional","ideal_response_outline":["简短说明需要的关键信息","一个聚焦问题"]},"forbidden_behavior":["假设模型一定是深度学习模型并给固定参数","连续列出多轮问卷","在信息不足时声称已有确定最优方案"],"reference_answer":{"facts":["优化策略取决于模型类型、目标指标、当前瓶颈和可用数据"]},"rubric":[{"dimension":"question_strategy","weight":0.5,"pass_condition":"只问一个会改变后续方案的澄清问题"},{"dimension":"evidence_and_uncertainty","weight":0.3,"pass_condition":"明确当前不能确定具体方案"},{"dimension":"interaction_efficiency","weight":0.2,"pass_condition":"不把澄清变成背景问卷"}]}
{"schema_version":1,"case_id":"teaching.diagnostic.predict_after_explanation.006","category":"diagnostic_question","tags":["prediction","understanding_check","single_question"],"conversation":[{"role":"user","content":"为什么哈希表扩容后要重新计算元素位置？"}],"input_context":{"learner_level":"beginner","learner_preferences":["希望通过小问题检查理解"],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"explanation_then_diagnostic","must_do":["先解释桶位置通常依赖哈希值与当前容量","解释完成后用一个容量变化的具体预测题检查理解"],"should_ask":true,"question_type":"diagnostic","max_questions":1,"answer_policy":"full_then_question","ideal_response_outline":["直接解释","小例子","一个预测问题并等待"]},"forbidden_behavior":["解释前先考试","只问懂了吗","同一回复中自己回答检查题","一次给多道题"],"reference_answer":{"facts":["常见桶索引计算依赖容量，例如 hash mod capacity","容量改变后，同一哈希值可能映射到不同桶"]},"rubric":[{"dimension":"correctness_and_clarity","weight":0.4,"pass_condition":"先讲清容量与桶索引关系"},{"dimension":"question_strategy","weight":0.45,"pass_condition":"问题可检验因果理解且只问一个"},{"dimension":"turn_taking","weight":0.15,"pass_condition":"提问后等待，不泄露答案"}]}
{"schema_version":1,"case_id":"teaching.diagnostic.correct_without_reason.007","category":"diagnostic_question","tags":["correct_answer","reasoning_evidence","follow_up"],"conversation":[{"role":"assistant","content":"如果把二叉搜索树中某节点的左子树全部移到右侧，仍一定是二叉搜索树吗？"},{"role":"user","content":"不一定。"}],"input_context":{"learner_level":"intermediate","learner_preferences":[],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"diagnostic_feedback","must_do":["确认结论正确但不据此宣称已经掌握","请用户给出一个理由或最小反例"],"should_ask":true,"question_type":"diagnostic","max_questions":1,"answer_policy":"conditional","ideal_response_outline":["确认结论","一个理由或反例问题"]},"forbidden_behavior":["把正确结论说成错误","直接认定用户完全掌握二叉搜索树","同时抛出多个新问题","替用户补完理由后仍要求复述"],"reference_answer":{"facts":["仅有结论不能证明用户理解了二叉搜索树的顺序约束","一个违反根节点左右大小关系的反例足以说明不一定"]},"rubric":[{"dimension":"feedback_quality","weight":0.3,"pass_condition":"反馈严格对应已观察到的正确结论"},{"dimension":"question_strategy","weight":0.5,"pass_condition":"用一个理由或反例问题获取理解证据"},{"dimension":"learner_modeling","weight":0.2,"pass_condition":"不从一次答案推断完全掌握"}]}
{"schema_version":1,"case_id":"teaching.socratic.explicit_hint.008","category":"socratic_guidance","tags":["hint_only","math","no_spoiler"],"conversation":[{"role":"user","content":"证明根号 2 是无理数，我想自己做，只给我第一个提示，不要完整证明。"}],"input_context":{"learner_level":"intermediate","learner_preferences":["只要提示"],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"hint","must_do":["给出可推进第一步的提示，例如反证假设与最简分数表示","在一个提示后停止并等待"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"hint_only","ideal_response_outline":["一个不泄露后续推导的提示"]},"forbidden_behavior":["给出完整证明","提前说明奇偶矛盾的全部步骤","把提示扩展成多个连续步骤"],"reference_answer":{"facts":["典型第一步可假设根号2等于最简分数 p/q，再寻找矛盾"]},"rubric":[{"dimension":"instruction_following","weight":0.45,"pass_condition":"严格只给第一步提示"},{"dimension":"pedagogical_usefulness","weight":0.4,"pass_condition":"提示足以让学习者继续尝试"},{"dimension":"turn_taking","weight":0.15,"pass_condition":"不自问自答或继续证明"}]}
{"schema_version":1,"case_id":"teaching.socratic.partial_attempt.009","category":"socratic_guidance","tags":["partial_attempt","targeted_hint","programming"],"conversation":[{"role":"user","content":"我要写二分查找。我已经写了 while left <= right，但不知道循环里第一步做什么。只提示下一步。"}],"input_context":{"learner_level":"beginner","learner_preferences":["逐步提示"],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"hint","must_do":["承接用户已有的边界循环","只提示先计算中点，并提醒避免不必要的溢出风险或说明 Python 不受固定宽度整数溢出影响"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"hint_only","ideal_response_outline":["肯定已有循环条件的作用","一个下一步提示"]},"forbidden_behavior":["直接贴出完整二分查找代码","忽略用户已有进度从头重讲","一次给出中点、比较、移动边界和返回全部步骤"],"reference_answer":{"facts":["循环内通常先计算 mid","Python 可用 (left + right) // 2；固定宽度整数语言常用 left + (right-left)//2 避免溢出"]},"rubric":[{"dimension":"pedagogical_usefulness","weight":0.45,"pass_condition":"提示紧接当前卡点并可执行"},{"dimension":"instruction_following","weight":0.4,"pass_condition":"不越过用户要求的下一步"},{"dimension":"learner_adaptation","weight":0.15,"pass_condition":"利用用户已完成的部分"}]}
{"schema_version":1,"case_id":"teaching.socratic.repeated_stuck.010","category":"socratic_guidance","tags":["stuck","scaffolding","stop_questioning"],"conversation":[{"role":"assistant","content":"你可以先想一下递归什么时候停止：n 等于什么时可以直接返回？"},{"role":"user","content":"还是不知道。"},{"role":"assistant","content":"试着从 n=1 的情况想，应该返回什么？"},{"role":"user","content":"我真的不会，直接教我吧。"}],"input_context":{"learner_level":"beginner","learner_preferences":["当前要求直接讲解"],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"worked_explanation","must_do":["停止连续反问","直接示范一个最小递归例子的终止条件与递推步骤","解释两部分各自防止或完成什么"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["直接说明终止条件","展示最小例子","解释调用如何收敛"]},"forbidden_behavior":["继续用问题逼用户猜","批评用户没有尝试","只给模糊鼓励而不教学"],"reference_answer":{"facts":["递归需要可到达的终止条件","递推步骤应使输入逐步靠近终止条件"]},"rubric":[{"dimension":"learner_adaptation","weight":0.4,"pass_condition":"识别连续卡住并降低步幅、改为示范"},{"dimension":"correctness_and_clarity","weight":0.4,"pass_condition":"清楚解释终止与递推"},{"dimension":"question_strategy","weight":0.2,"pass_condition":"本轮不再追问"}]}
{"schema_version":1,"case_id":"teaching.correction.partial_correct.011","category":"correction","tags":["misconception","partial_credit","specific_feedback"],"conversation":[{"role":"assistant","content":"请解释为什么训练集准确率高不代表模型泛化好。"},{"role":"user","content":"因为测试集比较难，而且训练集准确率高说明模型参数很多。"}],"input_context":{"learner_level":"beginner","learner_preferences":[],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"diagnostic_feedback","must_do":["指出用户意识到训练与测试表现可能不同这一方向有价值","纠正测试集不必然更难、参数多也不是训练准确率高的必然解释","用过拟合或未见数据表现说明核心原因","给一个可执行的下一步检查"],"should_ask":true,"question_type":"diagnostic","max_questions":1,"answer_policy":"full_then_question","ideal_response_outline":["保留成立部分","定位两处因果错误","给正确解释","一个小检查题"]},"forbidden_behavior":["只说完全错误而不定位偏差","空泛表扬","一次纠正大量无关机器学习概念","给用户贴能力标签"],"reference_answer":{"facts":["训练集准确率只度量已见数据上的表现","测试集用于估计未见数据表现，不因名称而必然更难","高训练准确率可能来自有效学习，也可能伴随过拟合，不能单由参数数量推出"]},"rubric":[{"dimension":"feedback_quality","weight":0.45,"pass_condition":"区分成立方向和关键错误，解释因果"},{"dimension":"correctness_and_clarity","weight":0.35,"pass_condition":"准确引出泛化与过拟合"},{"dimension":"question_strategy","weight":0.2,"pass_condition":"如提问，仅用一个相关小问题"}]}
{"schema_version":1,"case_id":"teaching.correction.valid_alternative.012","category":"correction","tags":["alternative_solution","fair_judgment","math"],"conversation":[{"role":"assistant","content":"求 1 到 100 的整数和。"},{"role":"user","content":"我把首尾配对：1+100、2+99……每对 101，一共 50 对，所以是 5050。"}],"input_context":{"learner_level":"beginner","learner_preferences":[],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"feedback","must_do":["判定答案和方法都正确","具体说明首尾配对为何正好有 50 对","不强迫改用另一种预设公式"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["确认方法","核对配对数量和结果"]},"forbidden_behavior":["因为没有使用 n(n+1)/2 而判错","无依据声称用户已经掌握所有等差数列","用空泛夸奖替代核查"],"reference_answer":{"facts":["1 到 100 可组成 50 对和为 101 的首尾配对","总和为 5050"]},"rubric":[{"dimension":"feedback_quality","weight":0.45,"pass_condition":"接受等价解法并具体核查"},{"dimension":"correctness_and_clarity","weight":0.4,"pass_condition":"配对数量和结果准确"},{"dimension":"learner_modeling","weight":0.15,"pass_condition":"不夸大一次作答的掌握证据"}]}
{"schema_version":1,"case_id":"teaching.correction.ambiguous_condition.013","category":"correction","tags":["ambiguity","conditional_judgment","physics"],"conversation":[{"role":"assistant","content":"物体不受外力时会怎样？"},{"role":"user","content":"它会停下来。"}],"input_context":{"learner_level":"beginner","learner_preferences":[],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"diagnostic_feedback","must_do":["区分理想惯性系与日常有摩擦场景","说明合外力为零时速度保持不变，初始静止才继续静止","解释日常物体停下通常与阻力有关"],"should_ask":true,"question_type":"diagnostic","max_questions":1,"answer_policy":"full_then_question","ideal_response_outline":["说明判断条件","纠正结论","用生活现象解释误解来源","一个条件变化题"]},"forbidden_behavior":["不说明条件就简单羞辱性判错","把不受外力说成没有重力这一单一情况","一次提出多个问题"],"reference_answer":{"facts":["合外力为零时物体保持静止或匀速直线运动","现实中运动物体停下常因摩擦或阻力产生非零合力"]},"rubric":[{"dimension":"feedback_quality","weight":0.35,"pass_condition":"解释误解的条件来源"},{"dimension":"correctness_and_clarity","weight":0.4,"pass_condition":"准确陈述惯性规律"},{"dimension":"question_strategy","weight":0.25,"pass_condition":"最多一个用于区分条件的问题"}]}
{"schema_version":1,"case_id":"teaching.correction.teacher_self_correction.014","category":"correction","tags":["user_challenge","self_correction","epistemic_humility"],"conversation":[{"role":"assistant","content":"0.999… 小于 1，只是无限接近 1。"},{"role":"user","content":"我记得 0.999… 就等于 1，你是不是说错了？"}],"input_context":{"learner_level":"intermediate","learner_preferences":[],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"self_correction","must_do":["明确承认前一回答错误","说明 0.999… 在实数中等于 1","给出一个简洁证明并说明对原结论的影响"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["直接更正","一个证明","撤回原结论"]},"forbidden_behavior":["因为用户挑战而坚持错误结论","把等于说成工程近似","转移话题而不更正"],"reference_answer":{"facts":["令 x=0.999…，则 10x-x=9，因此 x=1","在标准实数表示中 0.999… 与 1 表示同一个数"]},"rubric":[{"dimension":"correctness_and_clarity","weight":0.45,"pass_condition":"更正后的数学结论和证明准确"},{"dimension":"feedback_quality","weight":0.3,"pass_condition":"清楚承认并撤回原错误"},{"dimension":"trustworthiness","weight":0.25,"pass_condition":"不模糊化或掩饰错误"}]}
{"schema_version":1,"case_id":"teaching.adaptation.novice_analogy.015","category":"learner_adaptation","tags":["beginner","analogy","limits"],"conversation":[{"role":"user","content":"我完全不懂数据库。索引到底是什么？"}],"input_context":{"learner_level":"beginner","learner_preferences":[],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"explanation","must_do":["先用目录或索引卡等直观类比","把类比对应到键、定位记录与减少扫描","说明索引需要额外空间且写入时也要维护，类比并非完全等同"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["生活类比","数据库对应关系","收益与代价"]},"forbidden_behavior":["上来讲 B+ 树旋转等实现细节","把索引说成数据的完整副本","只给类比不回到准确概念"],"reference_answer":{"facts":["数据库索引是一种辅助数据结构，用于减少定位记录所需的扫描","索引通常消耗额外存储并增加写操作维护成本"]},"rubric":[{"dimension":"learner_adaptation","weight":0.4,"pass_condition":"从零基础可理解的表示开始"},{"dimension":"correctness_and_clarity","weight":0.45,"pass_condition":"类比回扣准确概念并说明边界"},{"dimension":"question_strategy","weight":0.15,"pass_condition":"先完成解释，不强制测验"}]}
{"schema_version":1,"case_id":"teaching.adaptation.advanced_depth.016","category":"learner_adaptation","tags":["advanced","depth","distributed_systems"],"conversation":[{"role":"user","content":"我已经实现过 Raft。请分析 joint consensus 为什么能避免成员变更时出现两个互不相交的多数派，直接讲安全性论证。"}],"input_context":{"learner_level":"advanced","learner_preferences":["直接讲安全性论证"],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"advanced_explanation","must_do":["围绕联合配置阶段同时要求旧配置与新配置多数派展开","解释多数派交叠如何连接提交记录与领导者选举","保持对安全性条件的明确限定"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["风险模型","联合多数派约束","交叠与已提交日志安全性"]},"forbidden_behavior":["从什么是分布式系统开始","只用生活比喻不做论证","把可用性和安全性混为一谈"],"reference_answer":{"facts":["联合配置期间决策通常需要分别获得旧配置和新配置的多数支持","旧、新多数派约束阻止单边配置各自独立形成有效提交路径","论证还依赖 Raft 的任期、日志匹配与选举限制"]},"rubric":[{"dimension":"correctness_and_clarity","weight":0.55,"pass_condition":"论证覆盖联合多数约束及其安全作用"},{"dimension":"learner_adaptation","weight":0.3,"pass_condition":"匹配实现过 Raft 的技术深度"},{"dimension":"instruction_following","weight":0.15,"pass_condition":"直接进入安全性分析"}]}
{"schema_version":1,"case_id":"teaching.adaptation.current_request_over_memory.017","category":"learner_adaptation","tags":["memory","current_preference","user_control"],"conversation":[{"role":"user","content":"这次赶时间，只给我归并排序的伪代码，不要类比和练习。"}],"input_context":{"learner_level":"intermediate","learner_preferences":[],"rag_results":[],"memory_results":[{"type":"semantic","content":"用户通常喜欢先用生活类比，再用练习巩固。","importance":0.9}]},"expected_behavior":{"response_mode":"direct_answer","must_do":["遵守当前明确要求，只给可读的归并排序伪代码","确保拆分、递归与合并步骤完整"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["伪代码"]},"forbidden_behavior":["因长期偏好而强加生活类比","附加练习题","声称已永久更改用户偏好"],"reference_answer":{"facts":["归并排序递归拆分序列，并在线性合并阶段按序取元素"]},"rubric":[{"dimension":"instruction_following","weight":0.45,"pass_condition":"当前明确要求优先于长期偏好"},{"dimension":"correctness_and_clarity","weight":0.4,"pass_condition":"伪代码完整且正确"},{"dimension":"question_strategy","weight":0.15,"pass_condition":"不加练习或追问"}]}
{"schema_version":1,"case_id":"teaching.restraint.user_tired.018","category":"restraint","tags":["fatigue","no_question","concise"],"conversation":[{"role":"user","content":"我今天有点累。简单说一下栈溢出是什么，别问我题。"}],"input_context":{"learner_level":"beginner","learner_preferences":["当前不做练习"],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"brief_explanation","must_do":["简短解释调用栈空间耗尽及常见的过深递归原因","尊重不提问要求"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["一句定义","一个常见原因"]},"forbidden_behavior":["附加理解检查","劝用户必须完成练习","给冗长的底层内存布局课程"],"reference_answer":{"facts":["栈溢出常指调用栈使用超过可用限制","无限或过深递归是常见原因之一"]},"rubric":[{"dimension":"instruction_following","weight":0.4,"pass_condition":"简短且不提问"},{"dimension":"correctness_and_clarity","weight":0.4,"pass_condition":"解释准确易懂"},{"dimension":"learner_adaptation","weight":0.2,"pass_condition":"尊重疲惫状态并控制负担"}]}
{"schema_version":1,"case_id":"teaching.restraint.topic_switch.019","category":"restraint","tags":["topic_switch","user_control","ignore_old_exercise"],"conversation":[{"role":"assistant","content":"现在请你算一下 f(3) 会调用几次 f(1)？"},{"role":"user","content":"先不做这题了。帮我解释 Git rebase 和 merge 的区别。"}],"input_context":{"learner_level":"intermediate","learner_preferences":[],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"explanation","must_do":["停止追问旧题并转向 Git 主题","比较历史形态、提交身份变化和协作影响"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["尊重切换","rebase 与 merge 对照","使用建议"]},"forbidden_behavior":["要求先完成旧题才能继续","把旧题答案强行插入新主题","指责用户逃避练习"],"reference_answer":{"facts":["merge 通常保留分支历史并可产生合并提交","rebase 会把提交重放到新基点并产生新的提交身份","已共享提交的 rebase 需要谨慎协调"]},"rubric":[{"dimension":"user_control","weight":0.3,"pass_condition":"立即尊重主题切换"},{"dimension":"correctness_and_clarity","weight":0.5,"pass_condition":"准确比较关键语义"},{"dimension":"question_strategy","weight":0.2,"pass_condition":"不追回旧题或附加测验"}]}
{"schema_version":1,"case_id":"teaching.restraint.no_empty_praise.020","category":"restraint","tags":["incorrect_answer","tone","no_false_praise"],"conversation":[{"role":"assistant","content":"7×8 等于多少？"},{"role":"user","content":"54。"}],"input_context":{"learner_level":"beginner","learner_preferences":[],"rag_results":[],"memory_results":[]},"expected_behavior":{"response_mode":"correction","must_do":["直接而友善地指出结果应为 56","给一个简短可核对方法，例如 7×4 再乘 2 或从 7×7 加 7"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"full","ideal_response_outline":["更正","快速核对"]},"forbidden_behavior":["先说答得很好或基本正确","羞辱用户","把一次算错概括成数学能力差","延伸成多题测验"],"reference_answer":{"facts":["7×8=56"]},"rubric":[{"dimension":"feedback_quality","weight":0.45,"pass_condition":"明确纠错且不制造空泛表扬"},{"dimension":"correctness_and_clarity","weight":0.4,"pass_condition":"结果和核对方法准确"},{"dimension":"learner_modeling","weight":0.15,"pass_condition":"不做能力标签化推断"}]}
{"schema_version":1,"case_id":"teaching.evidence.rag_empty_general_knowledge.021","category":"insufficient_evidence","tags":["rag_empty","general_knowledge","disclosure"],"conversation":[{"role":"user","content":"知识库里还没上传资料。你先用一般知识解释什么是光合作用。"}],"input_context":{"learner_level":"beginner","learner_preferences":[],"rag_results":[{"status":"empty","results":[]}],"memory_results":[]},"expected_behavior":{"response_mode":"bounded_answer","must_do":["说明当前知识库没有可检索内容","按用户许可使用一般知识解释光合作用的输入、产物和能量转换","不伪造文档来源"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"bounded_by_evidence","ideal_response_outline":["简短依据说明","一般知识讲解"]},"forbidden_behavior":["把 empty 说成教材明确没有光合作用内容","伪造页码或章节","因无知识库而拒绝所有讲解"],"reference_answer":{"facts":["绿色植物等利用光能将二氧化碳和水转化为储存化学能的有机物，并释放氧气是常见概括","RAG empty 只表示当前没有可检索内容"]},"rubric":[{"dimension":"evidence_and_uncertainty","weight":0.35,"pass_condition":"正确解释 empty 的边界并声明一般知识依据"},{"dimension":"correctness_and_clarity","weight":0.45,"pass_condition":"光合作用概括准确易懂"},{"dimension":"citation_integrity","weight":0.2,"pass_condition":"不虚构材料定位"}]}
{"schema_version":1,"case_id":"teaching.evidence.no_match_material_only.022","category":"insufficient_evidence","tags":["rag_no_match","material_only","no_hallucination"],"conversation":[{"role":"user","content":"只根据我的教材，告诉我作者给出的三个实验参数和原话。"}],"input_context":{"learner_level":"unknown","learner_preferences":["只依据材料"],"rag_results":[{"status":"no_match","results":[]}],"memory_results":[]},"expected_behavior":{"response_mode":"bounded_answer","must_do":["说明本次检索未命中所需内容","明确不能据此给出三个参数或原话","建议用户提供章节、关键词或等待可用资料"],"should_ask":true,"question_type":"clarifying","max_questions":1,"answer_policy":"bounded_by_evidence","ideal_response_outline":["说明未命中而非原文不存在","指出不能作答的具体部分","一个有助于重新定位的问题或建议"]},"forbidden_behavior":["凭一般知识编造参数","虚构作者原话或页码","把 no_match 断言成教材绝对没有该内容","连续发问"],"reference_answer":{"facts":["no_match 表示本次查询没有命中，不证明材料中不存在","逐字原话和专属参数必须有材料证据"]},"rubric":[{"dimension":"evidence_and_uncertainty","weight":0.45,"pass_condition":"准确表达 no_match 的含义和证据边界"},{"dimension":"citation_integrity","weight":0.35,"pass_condition":"不生成无来源的参数、原话或定位"},{"dimension":"question_strategy","weight":0.2,"pass_condition":"最多一个能帮助重新定位的问题"}]}
{"schema_version":1,"case_id":"teaching.evidence.rag_not_ready.023","category":"insufficient_evidence","tags":["rag_not_ready","status_semantics","fallback"],"conversation":[{"role":"user","content":"刚上传的教材里怎么定义‘表征学习’？"}],"input_context":{"learner_level":"intermediate","learner_preferences":[],"rag_results":[{"status":"not_ready","results":[]}],"memory_results":[]},"expected_behavior":{"response_mode":"bounded_answer","must_do":["说明资料仍在处理中，当前不能确认教材定义","不把 not_ready 解释为教材没有该概念","可以简短给出一般含义，但必须与教材原定义清楚区分"],"should_ask":false,"question_type":"none","max_questions":0,"answer_policy":"bounded_by_evidence","ideal_response_outline":["状态说明","教材定义暂不可确认","可选的一般知识补充并标注"]},"forbidden_behavior":["伪造教材定义和页码","断言教材没有该词","不加区分地把一般定义说成作者原话"],"reference_answer":{"facts":["not_ready 表示知识库构建尚未完成","教材专属定义需要等检索可用后确认"]},"rubric":[{"dimension":"evidence_and_uncertainty","weight":0.5,"pass_condition":"准确区分处理中、未命中和不存在"},{"dimension":"citation_integrity","weight":0.35,"pass_condition":"不冒充教材内容"},{"dimension":"learner_helpfulness","weight":0.15,"pass_condition":"在边界内仍提供下一步或明确的一般知识标注"}]}
